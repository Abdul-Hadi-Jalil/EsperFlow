{
  // Passes the backend URL + API key to every F5 run. Values live in
  // dart_defines.json (git-ignored) — copy dart_defines.example.json to create it.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "EsperFlow (debug)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": ["--dart-define-from-file", "dart_defines.json"]
    },
    {
      "name": "EsperFlow (release)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "release",
      "toolArgs": ["--dart-define-from-file", "dart_defines.json"]
    },
    {
      "name": "EsperFlow (local backend)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define",
        "API_BASE_URL=http://localhost:8000",
        "--dart-define",
        "API_TIMEOUT_SECONDS=20"
      ]
    }
  ]
}
