# Copy to .env and fill in. Never commit the real .env.

# --- HTTP server ---
HOST=0.0.0.0
PORT=8000

# Comma separated list of allowed browser origins, or * for any.
CORS_ORIGINS=*

# Shared secret the Flutter app must send as the "x-api-key" header.
# Leave empty to disable the check (local development only).
API_KEY=

# --- Firebase Admin credentials ---
# Firebase console > Project settings > Service accounts > Generate new private key.
# Provide EITHER a path to the downloaded json ...
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# ... OR the json itself (raw or base64), handy for Render/Railway/Cloud Run.


FIREBASE_PROJECT_ID=esperflow-1b828

# --- Firestore collections (must match the Flutter app) ---
DONORS_COLLECTION=donors
BLOOD_REQUESTS_COLLECTION=bloodRequests

# --- Broadcast behaviour ---
# true  -> only donors whose "activeDonorStatus" is true are notified
# false -> every registered donor holding a push token is notified
NOTIFY_ONLY_ACTIVE_DONORS=true
