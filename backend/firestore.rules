rules_version = '2';

// Deploy with:  firebase deploy --only firestore:rules
//
// The Admin SDK used by this backend bypasses these rules entirely, so they only
// constrain what the Flutter app itself may do.
service cloud.firestore {
  match /databases/{database}/documents {

    function isBloodGroup(value) {
      return value in ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-'];
    }

    // Donor registrations written by the Donate Blood screen.
    match /donors/{donorId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['bloodGroup'])
                            && isBloodGroup(request.resource.data.bloodGroup);
      allow delete: if false;
    }

    // Blood requests written by the Request Blood screen.
    match /bloodRequests/{requestId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasAll(['fullName', 'bloodGroup', 'location'])
                    && isBloodGroup(request.resource.data.bloodGroup)
                    && request.resource.data.fullName is string
                    && request.resource.data.fullName.size() >= 2
                    && request.resource.data.fullName.size() <= 120
                    && request.resource.data.location.size() <= 200
                    // Delivery counters are the backend's to write, never the client's.
                    && !request.resource.data.keys().hasAny(['notifiedCount', 'notifiedAt', 'notificationStatus']);

      // Only the trusted backend (Admin SDK) updates or removes a request.
      allow update, delete: if false;
    }

    match /User/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /donations/{donationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
